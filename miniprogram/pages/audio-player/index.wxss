.audio-page {
  padding: 0 28rpx 80rpx;
  overflow-x: hidden;
}

.audio-head {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: sticky;
  top: 0;
  z-index: 20;
  margin: 0 -28rpx 28rpx;
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.68);
  background: rgba(255, 255, 255, 0.97);
}

.back {
  position: absolute;
  left: 28rpx;
  color: #5d4326;
  font-size: 24rpx;
  font-weight: 900;
}

.head-title {
  color: #261d10;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.audio-card,
.player-card {
  background: #ffffff;
  border: 2rpx solid #c9b795;
  border-radius: 18rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 18rpx rgba(93, 67, 38, 0.08);
  margin-bottom: 24rpx;
}

.info-head {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
}

.audio-mark {
  height: 136rpx;
  border: 2rpx solid #ddd0b4;
  border-radius: 16rpx;
  background: #f7f1e6;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.audio-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.pick {
  width: 42rpx;
  height: 54rpx;
  border-radius: 50% 50% 50% 8rpx;
  background: #5d4326;
  transform: rotate(-28deg);
}

.wave-bars {
  position: absolute;
  right: 18rpx;
  bottom: 20rpx;
  display: flex;
  align-items: end;
  gap: 5rpx;
}

.wave-bars text {
  width: 6rpx;
  border-radius: 99rpx;
  background: #ff7f00;
}

.wave-bars text:nth-child(1) { height: 18rpx; }
.wave-bars text:nth-child(2) { height: 34rpx; }
.wave-bars text:nth-child(3) { height: 26rpx; }
.wave-bars text:nth-child(4) { height: 42rpx; }
.wave-bars text:nth-child(5) { height: 22rpx; }

.audio-title-wrap {
  min-width: 0;
}

.audio-title {
  color: #261d10;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.35;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.audio-meta,
.source {
  color: #7a6a52;
  font-size: 22rpx;
  line-height: 1.6;
}

.source {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(221, 208, 180, 0.7);
}

.source text {
  color: #5d4326;
  font-weight: 900;
}

.time-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  color: #7a6a52;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.time-row text:nth-child(2) {
  color: #5d4326;
  font-size: 23rpx;
  font-weight: 900;
}

.time-row text:last-child {
  text-align: right;
}

.progress-wrap {
  position: relative;
  margin-top: 20rpx;
  padding-top: 28rpx;
}

.seek-bubble {
  position: absolute;
  top: -8rpx;
  transform: translateX(-50%);
  min-width: 74rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #5d4326;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  z-index: 2;
}

.seek-bubble::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #5d4326;
}

.transport {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  column-gap: 8rpx;
  margin: 42rpx 0 8rpx;
}

.transport-icon {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d4326;
}

.loop-toggle {
  width: 88rpx;
  height: 52rpx;
  justify-self: center;
  color: rgba(93, 67, 38, 0.46);
  background: transparent;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 52rpx;
}

.loop-toggle.active {
  color: #5d4326;
}

.rewind-icon,
.forward-icon {
  gap: 4rpx;
}

.rewind-icon view,
.rewind-icon text,
.forward-icon view,
.forward-icon text,
.play-shape {
  width: 0;
  height: 0;
  border-top: 24rpx solid transparent;
  border-bottom: 24rpx solid transparent;
}

.rewind-icon view,
.rewind-icon text {
  border-right: 34rpx solid #5d4326;
}

.forward-icon view,
.forward-icon text,
.play-shape {
  border-left: 34rpx solid #5d4326;
}

.play-button {
  min-width: 96rpx;
}

.play-shape {
  margin-left: 8rpx;
  border-top-width: 32rpx;
  border-bottom-width: 32rpx;
  border-left-width: 48rpx;
}

.pause-shape {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.pause-shape text {
  width: 14rpx;
  height: 58rpx;
  border-radius: 3rpx;
  background: #5d4326;
}

.speed-toggle {
  font-size: 22rpx;
  font-weight: 950;
}

