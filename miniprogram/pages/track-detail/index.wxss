.lesson-page {
  padding: 0 28rpx 120rpx;
  overflow-x: hidden;
}

.player {
  border-radius: 16rpx;
  background: transparent;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(38, 29, 16, 0.18);
  margin-bottom: 20rpx;
  position: relative;
}

.video-player {
  width: 100%;
  height: 390rpx;
  display: block;
  background: #000000;
}

.video-state {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 9;
  transform: translate(-50%, -50%);
  min-width: 180rpx;
  max-width: 70%;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.58);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.video-state.error {
  color: #fff3f1;
  background: rgba(116, 32, 24, 0.82);
}

.video-empty {
  height: 390rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #24190f;
  color: #ffffff;
  text-align: center;
}

.video-empty-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 900;
}

.video-empty-desc {
  margin-top: 14rpx;
  color: rgba(255,255,255,0.68);
  font-size: 23rpx;
  line-height: 1.5;
}

.video-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 6rpx;
  min-height: 118rpx;
  padding: 18rpx 22rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.74));
  opacity: 1;
}

.video-controls.hide {
  opacity: 0;
}

.video-controls.show {
  opacity: 1;
}

.video-controls.compact {
  gap: 4rpx;
  height: 116rpx;
  min-height: 116rpx;
  padding: 12rpx 24rpx 16rpx;
}

.video-controls.full {
  gap: 10rpx;
  min-height: 150rpx;
  padding: 22rpx 56rpx 24rpx 40rpx;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.82));
}

.player.portrait-fullscreen .video-controls.full {
  bottom: 64rpx;
}

.control-row {
  width: 100%;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.left-controls,
.right-controls {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.right-controls {
  justify-content: flex-end;
}

.video-controls.compact .left-controls {
  width: 58rpx;
  height: 58rpx;
  gap: 0;
}

.video-controls.compact .right-controls {
  width: 58rpx;
  height: 58rpx;
}

.video-controls.full .control-row {
  min-height: 66rpx;
  gap: 22rpx;
}

.video-controls.full .left-controls,
.video-controls.full .right-controls {
  min-width: 190rpx;
  gap: 18rpx;
}

.ctrl-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.icon-ctrl {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
}

.video-controls.compact .icon-ctrl {
  width: 58rpx;
  height: 58rpx;
  font-size: 29rpx;
  line-height: 58rpx;
}

.video-controls.full .icon-ctrl {
  width: 64rpx;
  height: 64rpx;
  font-size: 31rpx;
}

.part-ctrl {
  width: 32rpx;
  height: 40rpx;
  gap: 3rpx;
  opacity: 0.38;
}

.part-ctrl .bar {
  width: 3rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.part-ctrl .tri {
  width: 0;
  height: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
}

.part-ctrl .tri.left {
  border-right: 14rpx solid #ffffff;
}

.part-ctrl .tri.right {
  border-left: 14rpx solid #ffffff;
}

.text-ctrl {
  min-width: 68rpx;
  height: 46rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
}

.progress-zone {
  width: 100%;
  height: 58rpx;
  display: flex;
  align-items: center;
  margin: 0;
}

.video-controls.compact .progress-zone {
  height: 50rpx;
  margin: 0;
}

.video-controls.full .progress-zone {
  min-width: 0;
  height: 74rpx;
  margin: 0;
}

.progress-touch {
  position: relative;
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.video-controls.full .progress-touch {
  height: 76rpx;
  padding: 0 14rpx;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  overflow: visible;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.progress-dot {
  position: absolute;
  top: 50%;
  z-index: 3;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  margin-top: -12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.16), 0 4rpx 12rpx rgba(0, 0, 0, 0.34);
}

.progress-dot.active {
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  margin-top: -15rpx;
  box-shadow: 0 0 0 10rpx rgba(255, 255, 255, 0.18), 0 6rpx 18rpx rgba(0, 0, 0, 0.38);
}

.video-controls.full .progress-track,
.video-controls.full .progress-fill {
  height: 10rpx;
}

.video-controls.full .progress-dot {
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  margin-top: -15rpx;
}

.video-controls.full .progress-dot.active {
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  margin-top: -18rpx;
}

.progress-bubble {
  position: absolute;
  top: -22rpx;
  z-index: 4;
  min-width: 70rpx;
  height: 36rpx;
  margin-left: -35rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #261d10;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.28);
}

.video-controls.full .progress-bubble {
  top: -16rpx;
  min-width: 82rpx;
  height: 42rpx;
  margin-left: -41rpx;
  font-size: 21rpx;
  line-height: 42rpx;
}

.time-label {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.video-controls.compact .time-label {
  font-size: 19rpx;
}

.video-controls.full .time-label {
  font-size: 22rpx;
  line-height: 52rpx;
}

.lesson-card {
  background: rgba(255, 255, 255, 0.97);
  border: 2rpx solid #c9b795;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(93, 67, 38, 0.08);
  padding: 22rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.lesson-title-row,
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  min-width: 0;
  color: #261d10;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 950;
  word-break: break-word;
}

.sec-note {
  flex: none;
  color: #7a6a52;
  font-size: 21rpx;
  font-weight: 800;
}

.lesson-summary {
  margin-top: 14rpx;
  color: #4f4230;
  font-size: 24rpx;
  line-height: 1.75;
}

.mini-title {
  color: #5d4326;
  font-size: 28rpx;
  font-weight: 950;
  letter-spacing: 1rpx;
}

.pre-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 18rpx;
}

.pre-node {
  width: 240rpx;
  min-height: 164rpx;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  vertical-align: top;
  margin-right: 16rpx;
  padding: 18rpx;
  border: 2rpx solid #ddd0b4;
  border-radius: 16rpx;
  background: #fffdf8;
}

.kind,
.type-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #f7f1e6;
  color: #5d4326;
  font-size: 19rpx;
  font-weight: 900;
}

.type-inline {
  width: 64rpx;
  padding: 0;
  justify-self: center;
}

.kind {
  justify-self: flex-start;
}

.pre-title {
  color: #261d10;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 900;
  white-space: nowrap;
  margin: 12rpx 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pre-duration,
.file-meta,
.part-meta {
  color: #7a6a52;
  font-size: 20rpx;
  line-height: 1.4;
}

.info-block {
  margin-top: 18rpx;
  border-top: 2rpx solid rgba(221, 208, 180, 0.82);
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.82);
  overflow: hidden;
  background: #ffffff;
}

.part,
.file-row {
  min-height: 90rpx;
  display: grid;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.62);
}

.part {
  grid-template-columns: 52rpx minmax(0, 1fr) auto;
}

.file-row {
  grid-template-columns: 52rpx minmax(0, 1fr) 72rpx auto;
}

.part:last-child,
.file-row:last-child {
  border-bottom: 0;
}

.part.active {
  background: #f2f7ec;
  border-left: 8rpx solid #4f7d3a;
  padding-left: 10rpx;
}

.part-no,
.file-no {
  color: #5d4326;
  font-size: 22rpx;
  font-weight: 950;
  text-align: center;
}

.part-main,
.file-main {
  min-width: 0;
}

.clip-title {
  color: #261d10;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.part-status {
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9b795;
  color: #5d4326;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
  background: #ffffff;
}

.part.active .part-status {
  border-color: transparent;
  color: #4f7d3a;
  background: transparent;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-btn {
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9b795;
  color: #5d4326;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
}

.action-btn.solid {
  border-color: #5d4326;
  color: #ffffff;
  background: #5d4326;
}
