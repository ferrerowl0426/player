# 前端页面地址，用于后端 CORS
FRONTEND_URL=http://你的服务器公网IP:3001

# 浏览器请求后端 API 的公开地址，构建前端镜像时会写入前端包
NEXT_PUBLIC_API_BASE_URL=http://你的服务器公网IP:3000/api

# 管理员登录 JWT 密钥，服务器部署时请改成一段长随机字符串
JWT_SECRET=请改成一段长随机字符串

# 腾讯云 COS / S3 兼容配置
S3_ENDPOINT=https://cos.ap-nanjing.myqcloud.com
S3_REGION=ap-nanjing
S3_BUCKET=你的存储桶名称
S3_ACCESS_KEY_ID=你的SecretId
S3_SECRET_ACCESS_KEY=你的SecretKey
S3_FORCE_PATH_STYLE=false
# 可选：本地 MinIO 直传时填写浏览器可访问的 endpoint，例如 http://localhost:9000
S3_PUBLIC_ENDPOINT=

# 浏览器访问视频和封面时使用的公开 COS 地址
PUBLIC_BUCKET_BASE_URL=https://你的存储桶名称.cos.ap-nanjing.myqcloud.com

# ----- 腾讯云 CDN TypeA 播放鉴权（可选，默认关闭）-----
# 业务来源/business：本服务为“吉他教学”业务（nxhguitar）的媒体分发，MEDIA 系列变量仅作用于该业务。
# 重要：本开关只是生成“应用侧”的 TypeA 签名参数。必须在腾讯云 CDN 控制台为对应域名
# 开启 TypeA 鉴权并配置“相同 key 与有效期”才会真正生效；控制台未开启前不要启用，
# 否则所有播放地址会 403。云端鉴权是独立配置项，本仓库不宣称已为你完成云端配置。
# CDN 播放地址转换（COS 源 -> CDN 域名）默认开启，本段仅控制“是否追加 TypeA 签名”。

# 是否开启 CDN TypeA 签名（true/false，默认 false）。开启后缺少合法 key 会导致启动失败（fail-fast）。
MEDIA_CDN_AUTH_ENABLED=false
# TypeA 鉴权 key：6-40 位字母数字；仅在上一项为 true 时必填，缺失或不合规将拒绝启动。
MEDIA_CDN_AUTH_KEY=
# TypeA 签名有效期（秒），必须与腾讯云 CDN 控制台“鉴权有效期”完全一致，默认 300。
MEDIA_CDN_AUTH_TTL_SECONDS=300
# 可选：追加可信 CDN 域名（逗号分隔，含协议），仅这些域名会被签名；默认已含 media.nxhguitar.com。
MEDIA_CDN_TRUSTED_DOMAINS=
