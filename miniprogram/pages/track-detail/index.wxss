.lesson-page {
  padding: 0 28rpx 120rpx;
  overflow-x: hidden;
}

.player {
  border-radius: 16rpx;
  background: transparent;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(38, 29, 16, 0.18);
  margin-bottom: 20rpx;
  position: relative;
}

.video-player {
  width: 100%;
  height: 390rpx;
  display: block;
  background: #000000;
}

.video-empty {
  height: 390rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #24190f;
  color: #ffffff;
  text-align: center;
}

.video-empty-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 900;
}

.video-empty-desc {
  margin-top: 14rpx;
  color: rgba(255,255,255,0.68);
  font-size: 23rpx;
  line-height: 1.5;
}

.video-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.64);
}

.video-controls.compact {
  gap: 14rpx;
}

.video-controls.full {
  gap: 14rpx;
  min-height: 84rpx;
  padding: 14rpx 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.78));
}

.ctrl-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.icon-ctrl {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
}

.part-ctrl {
  width: 58rpx;
  height: 48rpx;
  gap: 5rpx;
  opacity: 0.58;
}

.part-ctrl .bar {
  width: 6rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.part-ctrl .tri {
  width: 0;
  height: 0;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
}

.part-ctrl .tri.left {
  border-right: 24rpx solid #ffffff;
}

.part-ctrl .tri.right {
  border-left: 24rpx solid #ffffff;
}

.text-ctrl {
  min-width: 64rpx;
  height: 48rpx;
  padding: 0 8rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
}

.progress-zone {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.progress-track {
  position: relative;
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.progress-dot {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  margin-top: -12rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.time-label {
  flex: none;
  min-width: 132rpx;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.lesson-card {
  background: rgba(255, 255, 255, 0.97);
  border: 2rpx solid #c9b795;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(93, 67, 38, 0.08);
  padding: 22rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.lesson-title-row,
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  min-width: 0;
  color: #261d10;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 950;
  word-break: break-word;
}

.sec-note {
  flex: none;
  color: #7a6a52;
  font-size: 21rpx;
  font-weight: 800;
}

.lesson-summary {
  margin-top: 14rpx;
  color: #4f4230;
  font-size: 24rpx;
  line-height: 1.75;
}

.mini-title {
  color: #5d4326;
  font-size: 28rpx;
  font-weight: 950;
  letter-spacing: 1rpx;
}

.pre-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 18rpx;
}

.pre-node {
  width: 240rpx;
  min-height: 164rpx;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  vertical-align: top;
  margin-right: 16rpx;
  padding: 18rpx;
  border: 2rpx solid #ddd0b4;
  border-radius: 16rpx;
  background: #fffdf8;
}

.kind,
.type-inline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #f7f1e6;
  color: #5d4326;
  font-size: 19rpx;
  font-weight: 900;
}

.type-inline {
  width: 64rpx;
  padding: 0;
  justify-self: center;
}

.kind {
  justify-self: flex-start;
}

.pre-title {
  color: #261d10;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 900;
  white-space: nowrap;
  margin: 12rpx 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pre-duration,
.file-meta,
.part-meta {
  color: #7a6a52;
  font-size: 20rpx;
  line-height: 1.4;
}

.info-block {
  margin-top: 18rpx;
  border-top: 2rpx solid rgba(221, 208, 180, 0.82);
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.82);
  overflow: hidden;
  background: #ffffff;
}

.part,
.file-row {
  min-height: 90rpx;
  display: grid;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.62);
}

.part {
  grid-template-columns: 52rpx minmax(0, 1fr) auto;
}

.file-row {
  grid-template-columns: 52rpx minmax(0, 1fr) 72rpx auto;
}

.part:last-child,
.file-row:last-child {
  border-bottom: 0;
}

.part.active {
  background: #f2f7ec;
  border-left: 8rpx solid #4f7d3a;
  padding-left: 10rpx;
}

.part-no,
.file-no {
  color: #5d4326;
  font-size: 22rpx;
  font-weight: 950;
  text-align: center;
}

.part-main,
.file-main {
  min-width: 0;
}

.clip-title {
  color: #261d10;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.part-status {
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9b795;
  color: #5d4326;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
  background: #ffffff;
}

.part.active .part-status {
  border-color: transparent;
  color: #4f7d3a;
  background: transparent;
}

.actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-btn {
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  border: 2rpx solid #c9b795;
  color: #5d4326;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
}

.action-btn.solid {
  border-color: #5d4326;
  color: #ffffff;
  background: #5d4326;
}
