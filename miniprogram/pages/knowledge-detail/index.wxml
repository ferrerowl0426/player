<view class="page lesson-page">
  <view class="player">
    <course-video-player wx:if="{{detail.currentPart.videoUrl}}"
      id="courseVideoPlayer"
      media="{{videoMedia}}"
      active="{{videoActive}}"
      poster="{{detail.currentPart.coverUrl || detail.coverUrl}}"
      speed="{{speed}}"
      speed-options="{{speedOptions}}"
      quality="{{quality}}"
      quality-options="{{detail.currentPart.renditions}}"
      has-previous="{{detail.currentPart.hasPrevious}}"
      has-next="{{detail.currentPart.hasNext}}"
      bindplay="handleVideoPlay"
      bindpause="handleVideoPause"
      bindsourceconfirmed="handleVideoSourceConfirmed"
      bindtimeupdate="handleVideoTimeUpdate"
      bindended="handleVideoEnded"
      bindwaiting="handleVideoWaiting"
      binderror="handleVideoError"
      bindretry="handleVideoRetry"
      bindprevious="handlePrevious"
      bindnext="handleNext"
      bindqualitychange="handleQualityChange"
      bindspeedchange="handleSpeedChange"
    ></course-video-player>
    <view wx:if="{{!detail.currentPart.videoUrl}}" class="video-empty">
      <view class="video-empty-title">当前分 P 暂无视频</view>
      <view class="video-empty-desc">请切换其他分 P 或等待老师上传视频。</view>
    </view>
  </view>
  <view class="lesson-card intro-card">
    <view class="lesson-title-row">
      <view class="lesson-title">{{detail.title}}</view>
    </view>
    <view class="lesson-summary">{{detail.summary}}</view>
  </view>

  <view wx:if="{{detail.prerequisites.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">前置知识点</view>
      <view class="sec-note">滑动查看</view>
    </view>
    <scroll-view scroll-x class="pre-scroll" show-scrollbar="false">
      <block wx:for="{{detail.prerequisites}}" wx:key="id">
        <view class="pre-node" data-url="{{item.url}}" bindtap="openPrerequisite">
          <view class="kind">{{item.typeLabel}}</view>
          <view class="pre-title">{{item.title}}</view>
          <view class="pre-duration">{{item.duration}}</view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">播放列表</view>
      <view class="sec-note">{{detail.currentPartLabel}}</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.parts}}" wx:key="id">
        <view class="part {{item.active ? 'active' : ''}}" data-part="{{item.id}}" bindtap="selectPart">
          <view class="part-no">{{item.no}}</view>
          <view class="part-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="part-meta">{{item.duration}}</view>
          </view>
          <view class="part-status">{{item.statusText}}</view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{detail.attachments.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">附件资料</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.attachments}}" wx:key="id">
        <view class="file-row" data-file="{{item}}" bindtap="handleFileAction">
          <view class="file-no">{{item.no}}</view>
          <view class="file-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="file-meta">{{item.meta}}</view>
          </view>
          <view class="type-inline">{{item.fileType}}</view>
          <view class="actions" catchtap="noop">
            <view wx:if="{{item.canPreview}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">预览</view>
            <view wx:if="{{item.canPlay}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">播放</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{detail.libraryItems.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">关联图书馆</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.libraryItems}}" wx:key="id">
        <view class="file-row" data-file="{{item}}" bindtap="handleFileAction">
          <view class="file-no">{{item.no}}</view>
          <view class="file-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="file-meta">{{item.meta}}</view>
          </view>
          <view class="type-inline">{{item.fileType}}</view>
          <view class="actions" catchtap="noop">
            <view wx:if="{{item.canPreview}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">预览</view>
            <view wx:if="{{item.canPlay}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">播放</view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
