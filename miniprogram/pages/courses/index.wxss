.course-page {
  padding: 0 28rpx 170rpx;
  overflow-x: hidden;
}

.course-sticky {
  position: sticky;
  top: 0;
  z-index: 18;
  margin: 0 -28rpx 18rpx;
  padding: 18rpx 28rpx 20rpx;
  background: transparent;
}

.type-switch {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin: 4rpx 0 18rpx;
}

.type-option {
  min-width: 0;
  height: 72rpx;
  border: 2rpx solid #c9b795;
  border-radius: 16rpx;
  background: #ffffff;
  color: #5d4326;
  font-size: 22rpx;
  line-height: 72rpx;
  font-weight: 900;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(93, 67, 38, 0.05);
  overflow: hidden;
  white-space: nowrap;
}

.type-option.active {
  background: #5d4326;
  border-color: #5d4326;
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(93, 67, 38, 0.18);
}

.toolbar {
  margin-bottom: 16rpx;
}

.searchbar {
  width: 100%;
  height: 84rpx;
  border: 3rpx solid #5d4326;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 22rpx;
  box-shadow: 0 4rpx 18rpx rgba(93, 67, 38, 0.07);
}

.search-icon {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #7a6a52;
  border-radius: 50%;
  position: relative;
}

.search-icon::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 99rpx;
  background: #7a6a52;
  transform: rotate(45deg);
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 80rpx;
  color: #261d10;
  font-size: 25rpx;
}

.clear-btn {
  flex: none;
  height: 44rpx;
  padding: 0 16rpx;
  border: 2rpx solid #c9b795;
  border-radius: 8rpx;
  color: #5d4326;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 4rpx;
}

.list-title {
  color: #5d4326;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.list-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 2rpx;
  background: #ff7f00;
}

.sort-select {
  flex: none;
  height: 60rpx;
  padding: 0 52rpx 0 20rpx;
  border: 2rpx solid #c9b795;
  border-radius: 14rpx;
  color: #5d4326;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 56rpx;
  position: relative;
}

.sort-select::after {
  content: "";
  position: absolute;
  right: 20rpx;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #5d4326;
  border-bottom: 3rpx solid #5d4326;
  transform: rotate(45deg);
}

.sort-wrap {
  position: relative;
  flex: none;
}

.sort-trigger {
  height: 60rpx;
  padding: 0 40rpx 0 20rpx;
  border: 2rpx solid #c9b795;
  border-radius: 14rpx;
  color: #5d4326;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 56rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
}

.sort-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #5d4326;
  border-bottom: 3rpx solid #5d4326;
  transform: rotate(45deg);
  margin-top: -8rpx;
  transition: transform 0.2s ease;
}

.sort-arrow.open {
  transform: rotate(225deg);
  margin-top: 8rpx;
}

.sort-menu {
  position: absolute;
  top: 68rpx;
  right: 0;
  z-index: 30;
  min-width: 200rpx;
  padding: 8rpx;
  border: 2rpx solid #ddd0b4;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(93, 67, 38, 0.18);
}

.sort-option {
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #5d4326;
  font-size: 22rpx;
  font-weight: 800;
}

.sort-option:active {
  background: #f6f3ee;
}

.sort-option.active {
  color: #5d4326;
  background: #f6f3ee;
}

.sort-check {
  color: #5d4326;
  font-size: 24rpx;
  font-weight: 900;
}

.course-list {
  display: grid;
  gap: 18rpx;
}

.course-card {
  width: 100%;
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #ddd0b4;
  border-radius: 18rpx;
  padding: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(93, 67, 38, 0.06);
  overflow: hidden;
}

.course-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background-color: #3a2a18;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.course-cover.theme-k {
  background-color: #4a3b27;
}

.course-cover.theme-s {
  background-color: #65461f;
}

.course-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.disc {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 0 0 28rpx rgba(58, 42, 24, 0.65);
}

.course-count {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  max-width: 76rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  background: rgba(93, 67, 38, 0.88);
  color: #ffffff;
  font-size: 19rpx;
  line-height: 32rpx;
  font-weight: 900;
  overflow: hidden;
  white-space: nowrap;
}

.course-info {
  min-width: 0;
}

.course-name {
  color: #261d10;
  font-size: 27rpx;
  line-height: 1.42;
  font-weight: 900;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.course-meta {
  color: #7a6a52;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.backtop {
  position: fixed;
  right: 28rpx;
  bottom: 148rpx;
  z-index: 40;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 2rpx solid #c9b795;
  background: rgba(255, 255, 255, 0.96);
  color: #5d4326;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 950;
  box-shadow: 0 8rpx 24rpx rgba(93, 67, 38, 0.14);
}
