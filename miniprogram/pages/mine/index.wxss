.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #c9b795;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 3rpx solid #5d4326;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #5d4326;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-name {
  color: #261d10;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-meta {
  color: #7a6a52;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.info-list {
  background: #ffffff;
  border: 2rpx solid #c9b795;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.info-row {
  min-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 2rpx solid rgba(221, 208, 180, 0.7);
  color: #261d10;
  font-size: 24rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row text:last-child {
  color: #7a6a52;
}

.password-mask { position: fixed; inset: 0; z-index: 1000; background: rgba(38,29,16,.36); display: flex; align-items: center; justify-content: center; padding: 32rpx; box-sizing: border-box; }
.password-panel { width: 100%; max-width: 640rpx; max-height: 82vh; overflow-y: auto; background: #fffdf8; border: 2rpx solid #c9b795; border-radius: 20rpx; padding: 32rpx; box-sizing: border-box; color: #261d10; }
.password-heading { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 700; }
.password-eye::after { border: 0; }
.password-hint { font-size: 24rpx; color: #7a6a52; margin: 12rpx 0 24rpx; }
.password-label { margin: 20rpx 0 12rpx; font-size: 26rpx; }
.password-input-row { display: flex; align-items: center; min-height: 84rpx; border: 2rpx solid #c9b795; border-radius: 12rpx; background: #fff; }
.password-input-row input { flex: 1 1 0%; min-width: 0; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; }
.password-eye { flex: 0 0 80rpx; background: transparent; margin: 0; width: 80rpx; min-width: 80rpx; height: 80rpx; padding: 0; display: flex; align-items: center; justify-content: center; }
.eye-shape { position: relative; width: 30rpx; height: 20rpx; border: 3rpx solid #7a6a52; border-radius: 60% 60%; display: flex; align-items: center; justify-content: center; }
.eye-pupil { width: 9rpx; height: 9rpx; border-radius: 50%; background: #7a6a52; }
.eye-shape::after { content: ''; position: absolute; width: 38rpx; height: 3rpx; background: #7a6a52; transform: rotate(-45deg); }
.eye-visible::after { display: none; }
.password-error { min-height: 40rpx; margin: 16rpx 0; font-size: 24rpx; color: #a64f4f; line-height: 1.6; }
.password-actions { display: flex; align-items: center; gap: 20rpx; padding-bottom: env(safe-area-inset-bottom); }
.password-actions button { flex: 1 0 0%; min-width: 0; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0 16rpx; line-height: 80rpx; text-align: center; white-space: nowrap; font-size: 26rpx; border-radius: 12rpx; box-sizing: border-box; }
.password-cancel { border: 2rpx solid #5d4326; background: #fff; color: #5d4326; }
.password-submit { background: #5d4326; color: #fff; }
.password-success { padding: 40rpx 0; text-align: center; font-size: 28rpx; color: #4f7d3a; }

.help-text {
  color: #4f4230;
  font-size: 24rpx;
  line-height: 1.75;
}
