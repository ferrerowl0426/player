<view class="page collection-page">
  <view class="collection-content">
    <view class="set-head">
      <view class="set-cover knowledge-cover">
        <image wx:if="{{detail.coverUrl}}" class="set-cover-img" src="{{detail.coverUrl}}" mode="aspectFill" />
        <block wx:else>
          <view class="cover-line line-1"></view>
          <view class="cover-line line-2"></view>
          <view class="cover-line line-3"></view>
        </block>
      </view>
      <view class="set-info">
        <view class="type-tag">{{detail.typeLabel}}</view>
        <view class="set-title">{{detail.title}}</view>
        <view class="meta-row">
          <text>{{detail.totalText}}</text>
        </view>
      </view>
      <view wx:if="{{detail.desc}}" class="set-desc">{{detail.desc}}</view>
    </view>

    <view class="section-head">
      <view class="section-name">{{detail.sectionTitle}}</view>
    </view>

    <view wx:if="{{detail.lessons.length}}" class="lesson-list">
      <view class="lesson-card" wx:for="{{detail.lessons}}" wx:key="id" data-id="{{item.id}}" bindtap="openLesson">
        <view class="lesson-cover knowledge-lesson-cover">
          <image wx:if="{{item.coverUrl}}" class="lesson-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="lesson-lines"></view>
        </view>
        <view class="lesson-no">{{item.no}}</view>
        <view class="lesson-main">
          <view class="lesson-title">{{item.title}}</view>
          <view class="lesson-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-demo">
      <view class="empty-title">暂无可学习内容</view>
      <view>{{detail.emptyText}}</view>
    </view>
  </view>
</view>
