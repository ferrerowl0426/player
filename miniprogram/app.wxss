page {
  min-height: 100%;
  background: #ffffff;
  color: #261d10;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 140rpx;
  color: #261d10;
  background-color: #ffffff;
  background-image:
    linear-gradient(90deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(122,74,38,0.045) 100%);
  background-size: 84rpx 84rpx, 84rpx 84rpx, 100% 100%;
  background-position: 0 0, 0 0, 0 0;
  overflow-x: hidden;
}

.card {
  width: 100%;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #c9b795;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(93, 67, 38, 0.08);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title__text {
  color: #5d4326;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  position: relative;
  padding-left: 18rpx;
}

.section-title__text::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 8rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: #ff7f00;
}

.muted {
  color: #7a6a52;
  font-size: 22rpx;
}

.primary-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 12rpx;
  background: #5d4326;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(93, 67, 38, 0.18);
}

.ghost-btn {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  border-radius: 12rpx;
  border: 2rpx solid #c9b795;
  color: #5d4326;
  background: rgba(255,255,255,0.96);
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  white-space: nowrap;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  color: #ffffff;
  background: #ff7f00;
  font-size: 20rpx;
  font-weight: 900;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #c9b795;
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #ffffff;
  color: #261d10;
  font-size: 26rpx;
}

.search {
  width: 100%;
  height: 76rpx;
  border: 3rpx solid #5d4326;
  border-radius: 14rpx;
  padding: 0 22rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
}

.two-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  width: 100%;
}

.error-text {
  color: #b4452e;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 16rpx;
}
