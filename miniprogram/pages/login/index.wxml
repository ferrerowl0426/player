<view class="login-page">
  <view class="login-head">
    <view class="login-brand">
      <view class="brand-mark">
        <view class="mark-main"></view>
        <view class="mark-shadow"></view>
      </view>
      <text>能学慧吉他教室</text>
    </view>
    <view class="login-page-desc">吉他课堂笔记整理工具 · 无公开注册 · 无交易广告 · 无支付功能</view>
  </view>

  <view class="login-card">
    <view class="field">
      <text class="field-label">手机号 / 学生账号</text>
      <input class="input" value="{{account}}" placeholder="请输入学生账号" type="number" bindinput="onAccountInput" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" value="{{password}}" placeholder="请输入密码" password bindinput="onPasswordInput" />
    </view>

    <view wx:if="{{error}}" class="error-text">{{error}}</view>

    <button class="primary-btn login-btn" loading="{{loading}}" bindtap="onLogin">登录并进入</button>
  </view>
</view>
