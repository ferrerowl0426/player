<view class="page lesson-page">
  <view class="player {{isFullscreen ? 'fullscreen' : ''}} {{isPortraitFullscreen ? 'portrait-fullscreen' : ''}} {{isFullscreen && !isPortraitFullscreen ? 'landscape-fullscreen' : ''}}">
    <video wx:if="{{detail.currentPart.videoUrl}}" id="lessonVideo" class="video-player" src="{{detail.currentPart.videoUrl}}" poster="{{detail.currentPart.coverUrl || detail.coverUrl}}" controls="{{false}}" enable-progress-gesture="{{false}}" playback-rate="{{speed}}" show-fullscreen-btn="{{false}}" show-play-btn="{{false}}" show-center-play-btn="{{false}}" show-casting-button="{{false}}" object-fit="{{videoObjectFit}}" direction="{{videoDirection}}" bindloadedmetadata="handleVideoLoadedMeta" bindplay="handleVideoPlay" bindcanplay="handleVideoCanPlay" bindpause="handleVideoPause" bindtimeupdate="handleVideoTimeUpdate" bindended="handleVideoEnded" bindwaiting="handleVideoWaiting" binderror="handleVideoError" bindfullscreenchange="handleFullscreenChange" bindtap="showVideoControls" bindtouchstart="showVideoControls">
      <cover-view class="video-controls {{controlsVisible ? 'show' : 'hide'}} {{isFullscreen ? 'full' : 'compact'}}">
        <cover-view class="progress-zone" catchtouchstart="startSeekVideo" catchtouchmove="moveSeekVideo" catchtouchend="endSeekVideo" catchtouchcancel="endSeekVideo">
          <cover-view class="progress-touch">
            <cover-view class="progress-track" catchtouchstart="startSeekVideo" catchtouchmove="moveSeekVideo" catchtouchend="endSeekVideo" catchtouchcancel="endSeekVideo">
              <cover-view class="progress-fill" style="width: {{progressPercent}}%;"></cover-view>
              <cover-view class="progress-dot {{isSeeking ? 'active' : ''}}" style="left: {{progressPercent}}%;" catchtouchstart="startSeekVideo" catchtouchmove="moveSeekVideo" catchtouchend="endSeekVideo" catchtouchcancel="endSeekVideo"></cover-view>
            </cover-view>
          </cover-view>
        </cover-view>
        <cover-view wx:if="{{isSeeking}}" class="progress-bubble" style="left: {{progressDotPercent}}%;">{{seekTimeText}}</cover-view>
        <cover-view class="control-row">
          <cover-view class="left-controls">
            <cover-view wx:if="{{isFullscreen && !isPortraitVideo}}" class="ctrl-btn part-ctrl" data-step="-1" bindtap="switchPartByStep"><cover-image class="part-icon-image" src="/assets/icons/player-prev.png"></cover-image></cover-view>
            <cover-view class="ctrl-btn icon-ctrl" bindtap="togglePlay"><cover-image class="player-icon-image" src="{{isPlaying ? '/assets/icons/player-pause.png' : '/assets/icons/player-play.png'}}"></cover-image></cover-view>
            <cover-view wx:if="{{isFullscreen && !isPortraitVideo}}" class="ctrl-btn part-ctrl" data-step="1" bindtap="switchPartByStep"><cover-image class="part-icon-image" src="/assets/icons/player-next.png"></cover-image></cover-view>
          </cover-view>
          <cover-view class="time-label">{{currentTimeText}} / {{durationText}}</cover-view>
          <cover-view class="right-controls">
            <cover-view wx:if="{{detail.currentPart.hasQualityOptions}}" class="ctrl-btn text-ctrl" bindtap="cycleQuality">{{qualityLabel}}</cover-view>
            <cover-view class="ctrl-btn text-ctrl speed-trigger {{speedMenuVisible ? 'active' : ''}}" bindtap="toggleSpeedMenu">{{speedLabel}}</cover-view>
            <cover-view class="ctrl-btn icon-ctrl" bindtap="toggleFullscreen"><cover-image class="player-icon-image" src="{{isFullscreen ? '/assets/icons/player-exit-fullscreen.png' : '/assets/icons/player-fullscreen.png'}}"></cover-image></cover-view>
          </cover-view>
        </cover-view>
        <cover-view wx:if="{{speedMenuVisible}}" class="speed-menu" bindtap="noop">
          <cover-view class="speed-menu-title">播放速度</cover-view>
          <cover-view class="speed-options">
            <cover-view wx:for="{{speedOptions}}" wx:key="value" class="speed-option {{speed === item.value ? 'active' : ''}}" data-speed="{{item.value}}" bindtap="selectSpeed">{{item.label}}</cover-view>
          </cover-view>
        </cover-view>
      </cover-view>
    </video>
    <cover-view wx:if="{{detail.currentPart.videoUrl && (videoWaiting || videoErrorText)}}" class="video-state {{videoErrorText ? 'error' : ''}}">
      {{videoErrorText || '视频加载中…'}}
    </cover-view>
    <view wx:if="{{!detail.currentPart.videoUrl}}" class="video-empty">
      <view class="video-empty-title">当前分 P 暂无视频</view>
      <view class="video-empty-desc">请切换其他分 P 或等待老师上传视频。</view>
    </view>
  </view>

  <view class="lesson-card intro-card">
    <view class="lesson-title-row">
      <view class="lesson-title">{{detail.title}}</view>
    </view>
    <view class="lesson-summary">{{detail.summary}}</view>
  </view>

  <view wx:if="{{detail.prerequisites.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">前置知识点</view>
      <view class="sec-note">滑动查看</view>
    </view>
    <scroll-view scroll-x class="pre-scroll" show-scrollbar="false">
      <block wx:for="{{detail.prerequisites}}" wx:key="id">
        <view class="pre-node" data-url="{{item.url}}" bindtap="openPrerequisite">
          <view class="kind">{{item.typeLabel}}</view>
          <view class="pre-title">{{item.title}}</view>
          <view class="pre-duration">{{item.duration}}</view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">播放列表</view>
      <view class="sec-note">{{detail.currentPartLabel}}</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.parts}}" wx:key="id">
        <view class="part {{item.active ? 'active' : ''}}" data-part="{{item.id}}" bindtap="selectPart">
          <view class="part-no">{{item.no}}</view>
          <view class="part-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="part-meta">{{item.duration}}</view>
          </view>
          <view class="part-status">{{item.statusText}}</view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{detail.attachments.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">附件资料</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.attachments}}" wx:key="id">
        <view class="file-row" data-file="{{item}}" bindtap="handleFileAction">
          <view class="file-no">{{item.no}}</view>
          <view class="file-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="file-meta">{{item.meta}}</view>
          </view>
          <view class="type-inline">{{item.fileType}}</view>
          <view class="actions" catchtap="noop">
            <view wx:if="{{item.canPreview}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">预览</view>
            <view wx:if="{{item.canPlay}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">播放</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{detail.libraryItems.length}}" class="lesson-card">
    <view class="sec-head">
      <view class="mini-title">关联图书馆</view>
    </view>
    <view class="info-block">
      <block wx:for="{{detail.libraryItems}}" wx:key="id">
        <view class="file-row" data-file="{{item}}" bindtap="handleFileAction">
          <view class="file-no">{{item.no}}</view>
          <view class="file-main">
            <view class="clip-title">{{item.title}}</view>
            <view class="file-meta">{{item.meta}}</view>
          </view>
          <view class="type-inline">{{item.fileType}}</view>
          <view class="actions" catchtap="noop">
            <view wx:if="{{item.canPreview}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">预览</view>
            <view wx:if="{{item.canPlay}}" class="action-btn" data-file="{{item}}" bindtap="handleFileAction">播放</view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
