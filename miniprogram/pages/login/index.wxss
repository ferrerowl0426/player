.login-page {
  min-height: 100vh;
  padding: 64rpx 28rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  background-image:
    linear-gradient(90deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #ffffff 0%, #fff7ea 100%);
  background-size: 84rpx 84rpx, 84rpx 84rpx, 100% 100%;
  overflow-x: hidden;
}

.login-head {
  width: 100%;
  max-width: 680rpx;
  padding: 34rpx 4rpx 26rpx;
  text-align: center;
}

.login-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #3d2c19;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-mark {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex: none;
}

.mark-main,
.mark-shadow {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
}

.mark-main {
  left: 0;
  top: 0;
  background: #f58724;
}

.mark-shadow {
  right: 0;
  bottom: 0;
  background: rgba(245, 135, 36, 0.22);
}

.login-page-desc {
  width: 100%;
  margin-top: 20rpx;
  color: #9a876f;
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 3rpx solid #5d4326;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 24rpx 56rpx rgba(93, 67, 38, 0.12);
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: #5d4326;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.login-btn {
  width: 360rpx;
  margin: 28rpx auto 0;
}

