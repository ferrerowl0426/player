<view class="page audio-page">
  <view class="audio-head">
    <view class="back" bindtap="goBack">返回</view>
    <view class="head-title">音频播放</view>
  </view>

  <view class="audio-card">
    <view class="info-head">
      <view class="audio-mark">
        <image wx:if="{{coverUrl}}" class="audio-cover" src="{{coverUrl}}" mode="aspectFill" />
        <block wx:else>
          <view class="pick"></view>
          <view class="wave-bars"><text></text><text></text><text></text><text></text><text></text></view>
        </block>
      </view>
      <view class="audio-title-wrap">
        <view class="audio-title">{{title || '音频文件'}}</view>
        <view class="audio-meta">{{audioFormat}} · {{durationText}}</view>
      </view>
    </view>
    <view class="source">来源：<text>{{source || '天空之城 · 主歌段落慢速跟练'}}</text></view>
  </view>

  <view class="player-card {{playing ? 'playing' : ''}}">
    <view wx:if="{{audioWaiting}}" class="audio-state">音频加载中…</view>
    <view wx:if="{{audioErrorText}}" class="audio-state error">{{audioErrorText}}</view>
    <view class="time-row"><text>{{currentTimeText}}</text><text>{{audioFormat}}</text><text>{{durationText}}</text></view>
    <view class="progress-wrap">
      <view wx:if="{{seeking}}" class="seek-bubble" style="left: {{progress}}%;">{{currentTimeText}}</view>
      <view class="audio-progress-touch" catchtouchstart="startAudioSeek" catchtouchmove="moveAudioSeek" catchtouchend="endAudioSeek" catchtouchcancel="endAudioSeek">
        <view class="audio-progress-track">
          <view class="audio-progress-fill" style="width: {{progress}}%;"></view>
          <view class="audio-progress-dot {{seeking ? 'active' : ''}}" style="left: {{progress}}%;"></view>
        </view>
      </view>
    </view>
    <view class="transport">
      <view class="transport-icon loop-toggle {{loop ? 'active' : ''}}" bindtap="toggleLoop">循环</view>
      <view class="transport-icon rewind-icon" bindtap="rewind"><view></view><text></text></view>
      <view class="transport-icon play-button" bindtap="togglePlay">
        <view wx:if="{{playing}}" class="pause-shape"><text></text><text></text></view>
        <view wx:else class="play-shape"></view>
      </view>
      <view class="transport-icon forward-icon" bindtap="forward"><text></text><view></view></view>
      <view class="transport-icon speed-toggle" bindtap="toggleSpeed">{{speedText}}</view>
    </view>
  </view>
</view>
