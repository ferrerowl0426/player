<view class="player-shell">
  <view class="safe-area-probe"></view>
  <video
    id="courseVideo"
    class="video"
    data-source-id="{{sourceId}}"
    data-source-token="{{sourceToken}}"
    src="{{videoSrc}}"
    poster="{{poster}}"
    initial-time="{{initialTime}}"
    controls="{{false}}"
    enable-progress-gesture="{{isFullscreen}}"
    enable-play-gesture="{{false}}"
    show-fullscreen-btn="{{false}}"
    show-play-btn="{{false}}"
    show-center-play-btn="{{false}}"
    show-casting-button="{{false}}"
    object-fit="{{objectFit}}"
    direction="{{videoDirection}}"
    playback-rate="{{speed}}"
    bindloadedmetadata="handleLoadedMetadata"
    bindplay="handlePlay"
    bindpause="handlePause"
    bindtimeupdate="handleTimeUpdate"
    bindseekcomplete="handleSeekComplete"
    bindended="handleEnded"
    bindwaiting="handleWaiting"
    binderror="handleError"
    bindfullscreenchange="handleFullscreenChange"
    bindtap="toggleControls"
  >
    <!-- Fullscreen chrome stays docked at the bottom so the open video area can
         receive enable-progress-gesture and bindtap. A full-screen cover-view
         would swallow those native touches on iOS. -->
    <cover-view
      wx:if="{{videoSrc && isFullscreen && controlsVisible}}"
      class="control-layer control-dock fullscreen {{fullscreenDirection === 'horizontal' ? 'landscape' : 'portrait'}}"
      style="{{insetStyle}}"
      catchtap="closeMenu"
    >
      <cover-view class="control-content control-content-dock">
        <cover-view class="progress-zone">
          <cover-view class="progress-track">
            <cover-view class="progress-fill" style="width: {{progressPercent}}%;"></cover-view>
          </cover-view>
          <cover-view class="progress-dot {{isSeeking ? 'active' : ''}} {{progressPercent < 3 ? 'start' : ''}} {{progressPercent >= 100 ? 'end' : ''}}" style="left: {{progressPercent}}%;"></cover-view>
          <cover-view class="progress-touch" catchtap="tapSeek" catchtouchstart="startSeek" catchtouchmove="moveSeek" catchtouchend="endSeek" catchtouchcancel="endSeek"></cover-view>
        </cover-view>
        <cover-view class="control-row">
          <cover-view class="transport-controls">
            <cover-view wx:if="{{fullscreenDirection === 'horizontal'}}" class="control-button part-button transport-button transport-first {{hasPrevious ? '' : 'disabled'}}" catchtap="handlePrevious">
              <cover-image class="control-icon" src="/assets/icons/player-prev.png"></cover-image>
            </cover-view>
            <cover-view class="control-button play-button transport-button" catchtap="togglePlay">
              <cover-image class="control-icon" src="{{isPlaying ? '/assets/icons/player-pause.png' : '/assets/icons/player-play.png'}}"></cover-image>
            </cover-view>
            <cover-view wx:if="{{fullscreenDirection === 'horizontal'}}" class="control-button part-button transport-button {{hasNext ? '' : 'disabled'}}" catchtap="handleNext">
              <cover-image class="control-icon" src="/assets/icons/player-next.png"></cover-image>
            </cover-view>
          </cover-view>

          <cover-view class="time-label">{{currentTimeText}} / {{durationText}}</cover-view>

          <cover-view class="option-controls">
            <cover-view wx:if="{{qualityOptions.length > 1}}" class="text-button option-button option-first {{menu === 'quality' ? 'active' : ''}}" data-menu="quality" catchtap="toggleMenu"><cover-view class="text-button-label">{{qualityLabel}}</cover-view></cover-view>
            <cover-view class="text-button option-button {{qualityOptions.length > 1 ? '' : 'option-first'}} {{menu === 'speed' ? 'active' : ''}}" data-menu="speed" catchtap="toggleMenu"><cover-view class="text-button-label">{{speedLabel}}</cover-view></cover-view>
            <cover-view class="control-button fullscreen-button option-button {{metadataReady && !fullscreenTransition ? '' : 'disabled'}}" catchtap="toggleFullscreen">
              <cover-image class="control-icon" src="/assets/icons/player-exit-fullscreen.png"></cover-image>
            </cover-view>
          </cover-view>
        </cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{isFullscreen && isSeeking}}" class="seek-bubble" style="{{bubbleStyle}}">{{currentTimeText}}</cover-view>

    <cover-view wx:if="{{isFullscreen && menu === 'speed'}}" class="player-popup speed-popup {{fullscreenDirection === 'horizontal' ? 'landscape' : 'portrait'}}" style="{{popupStyle}}" catchtap="noop">
      <cover-view class="popup-title">播放速度</cover-view>
      <cover-view class="popup-options">
        <cover-view wx:for="{{speedOptions}}" wx:key="value" class="popup-option {{speed === item.value ? 'active' : ''}}" data-speed="{{item.value}}" catchtap="selectSpeed">
          <cover-view class="popup-option-main">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{isFullscreen && menu === 'quality'}}" class="player-popup quality-popup {{fullscreenDirection === 'horizontal' ? 'landscape' : 'portrait'}}" style="{{popupStyle}}" catchtap="noop">
      <cover-view class="popup-title">清晰度</cover-view>
      <cover-view class="popup-options">
        <cover-view wx:for="{{qualityOptions}}" wx:key="quality" class="popup-option {{quality === item.quality ? 'active' : ''}}" data-quality="{{item.quality}}" catchtap="selectQuality">
          <cover-view class="popup-option-main">{{item.label}}</cover-view>
        </cover-view>
      </cover-view>
    </cover-view>

    <cover-view wx:if="{{isFullscreen && (waiting || errorText)}}" class="video-state {{errorText ? 'error' : ''}} fullscreen-state" style="{{statusStyle}}" catchtap="retry">
      {{errorText || '视频加载中…'}}
    </cover-view>
  </video>

  <!-- Windowed same-layer view controls so iOS can drag the progress bar. -->
  <view wx:if="{{videoSrc && !isFullscreen}}" class="control-layer windowed" catchtap="toggleControls" catchtouchmove="holdLayerTouch">
    <view wx:if="{{controlsVisible}}" class="control-content" style="{{insetStyle}}" catchtap="closeMenu">
      <view class="progress-zone">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-dot {{isSeeking ? 'active' : ''}} {{progressPercent < 3 ? 'start' : ''}} {{progressPercent >= 100 ? 'end' : ''}}" style="left: {{progressPercent}}%;"></view>
        <view class="progress-touch" catchtap="tapSeek" catchtouchstart="startSeek" catchtouchmove="moveSeek" catchtouchend="endSeek" catchtouchcancel="endSeek"></view>
      </view>
      <view class="control-row">
        <view class="transport-controls">
          <view class="control-button part-button transport-button transport-first {{hasPrevious ? '' : 'disabled'}}" catchtap="handlePrevious">
            <image class="control-icon" src="/assets/icons/player-prev.png"></image>
          </view>
          <view class="control-button play-button transport-button" catchtap="togglePlay">
            <image class="control-icon" src="{{isPlaying ? '/assets/icons/player-pause.png' : '/assets/icons/player-play.png'}}"></image>
          </view>
          <view class="control-button part-button transport-button {{hasNext ? '' : 'disabled'}}" catchtap="handleNext">
            <image class="control-icon" src="/assets/icons/player-next.png"></image>
          </view>
        </view>

        <view class="time-label">{{currentTimeText}} / {{durationText}}</view>

        <view class="option-controls">
          <view class="control-button fullscreen-button option-button option-first {{metadataReady && !fullscreenTransition ? '' : 'disabled'}}" catchtap="toggleFullscreen">
            <image class="control-icon" src="/assets/icons/player-fullscreen.png"></image>
          </view>
        </view>
      </view>
    </view>

    <view class="seek-bubble" hidden="{{!isSeeking}}" style="{{bubbleStyle}}">{{currentTimeText}}</view>

    <view wx:if="{{waiting || errorText}}" class="video-state {{errorText ? 'error' : ''}}" style="{{statusStyle}}" catchtap="retry">
      {{errorText || '视频加载中…'}}
    </view>
  </view>
</view>
