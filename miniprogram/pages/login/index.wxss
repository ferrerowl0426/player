.login-page {
  min-height: 100vh;
  padding: 64rpx 28rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  background-image:
    linear-gradient(90deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(122, 74, 38, 0.10) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #ffffff 0%, #fff7ea 100%);
  background-size: 84rpx 84rpx, 84rpx 84rpx, 100% 100%;
  overflow-x: hidden;
}

.login-head {
  width: 100%;
  max-width: 640rpx;
  padding: 22rpx 4rpx 28rpx;
  text-align: center;
}

.login-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #261d10;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.login-brand::before {
  content: "";
  width: 18rpx;
  height: 18rpx;
  background: #ff7f00;
  display: block;
  flex: none;
}

.login-page-title {
  color: #261d10;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-top: 28rpx;
}

.login-page-desc {
  color: #4f4230;
  font-size: 25rpx;
  line-height: 1.75;
  margin-top: 14rpx;
  text-align: center;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 3rpx solid #5d4326;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 24rpx 56rpx rgba(93, 67, 38, 0.12);
}

.login-title {
  color: #261d10;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.login-desc,
.login-note {
  color: #7a6a52;
  font-size: 24rpx;
  line-height: 1.75;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: #5d4326;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.login-btn {
  width: 360rpx;
  margin: 28rpx auto 0;
}

.preview-btn {
  width: 360rpx;
  margin: 18rpx auto 0;
}

.login-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #ddd0b4;
}
